{
  "name": "@letta-ai/jev-auto",
  "version": "0.2.0",
  "description": "Approve low-impact Letta Code tool calls with Jev.",
  "author": "Sarah Wooders",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/letta-ai/mods.git",
    "directory": "packages/jev-auto"
  },
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "check": "node --check mods/auto.mjs && node --test test/offline.test.mjs",
    "test:live": "node --test test/live.test.mjs",
    "test:cli": "node --test test/cli.test.mjs"
  },
  "keywords": [
    "letta-package",
    "letta-mod"
  ],
  "files": [
    "README.md",
    "MOD.md",
    "mods"
  ],
  "letta": {
    "manifestVersion": 1,
    "mods": [
      "./mods/auto.mjs"
    ],
    "capabilities": ["commands", "permissions", "events.lifecycle", "ui.panels"],
    "engines": { "lettaCodeCli": ">=0.32.12" }
  }
}
