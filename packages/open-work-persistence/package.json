{
  "name": "open-work-persistence",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "letta-package",
    "letta-mod",
    "letta-code",
    "persistence",
    "auto-continue",
    "open-work"
  ],
  "files": [
    "README.md",
    "MOD.md",
    "mods",
    "tests"
  ],
  "letta": {
    "manifestVersion": 1,
    "mods": [
      "mods/open-work-persistence.ts"
    ],
    "capabilities": ["events.turns"]
  },
  "description": "Letta Code mod for explicitly declared, identity-scoped, budgeted turn continuation.",
  "author": "Cyan Society (Ezra Cyan)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/letta-ai/mods.git",
    "directory": "packages/open-work-persistence"
  },
  "scripts": {
    "test": "node --loader ./tests/typescript-loader.mjs --test tests/identity.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
